# Copy to .env locally. Do not commit real values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional public Stream account id for docs only — API token must NOT be a VITE_ var.
# Set CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_STREAM_TOKEN as Supabase Edge Function secrets.
VITE_CLOUDFLARE_ACCOUNT_ID=
