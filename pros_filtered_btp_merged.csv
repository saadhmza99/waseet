r.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/calix-ingenierie"",""name"":""CALIX Ingénierie"",""description"":""CALIX Ingénierie est un bureau d’études techniques indépendant spécialisé en géotechnique, intervenant à l’échelle nationale. Il accompagne les maîtres d’ouvrage, promoteurs, architectes et entreprises à toutes les phases des projets, depuis les études préliminaires jusqu’au suivi d’exécution et aux expertises.\n\nLe bureau propose une offre complète couvrant les missions géotechniques G1 à G5 : reconnaissance des sols, campagnes d’investigations in situ (sondages, essais pressiométriques, pénétrométriques…), essais de laboratoire (identification, mécanique des sols, consolidation, cisaillement), ainsi que le dimensionnement des fondations et ouvrages géotechniques. CALIX intervient également en suivi des travaux (mission G4) et en diagnostic des ouvrages existants (G5).\n\nGrâce à une approche intégrée alliant terrain, laboratoire et modélisation, CALIX Ingénierie garantit des études fiables, conformes aux normes en vigueur, notamment l’Eurocode 7. Le bureau se distingue par sa réactivité, son expertise technique et sa capacité à proposer des solutions optimisées, adaptées aux contraintes de chaque projet.\n\nSon objectif est de sécuriser les projets, maîtriser les risques géotechniques et contribuer à la durabilité et à la performance des ouvrages."",""image"":""https://lechantier.ma/uploads/media/7423209ae7ce.webp"",""logo"":""https://lechantier.ma/uploads/media/6d97441d7a35.webp"",""telephone"":""+212628928665"",""url"":""https://lechantier.ma/pros/profil/calix-ingenierie"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""Hay Old Mimoune , route Zghanghan, Nador"",""addressLocality"":""Nador"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Agadir"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Agadir"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Al Hoceima"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Al Hoceima"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Casablanca"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""El Jadida"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""El Jadida"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Essaouira"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Essaouira"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Fès"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Fès"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Kénitra"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Kénitra"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Larache"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Larache"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Marrakech"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Meknès"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Meknès"",""addressCountry"":""MA""}},{"