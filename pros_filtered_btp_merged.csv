ier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/orca-lum"",""name"":""Orca Lum"",""description"":""ORCA LUM – Profil de société\nSecteur d’activité :\n\nConstruction et menuiserie industrielle\nSous-secteurs :\n\nMenuiserie aluminium : portes, fenêtres, façades, cloisons, volets, baies vitrées sur mesure\n\nPortes isothermes et solutions techniques pour hôpitaux, hôtels, industries agroalimentaires et chambres froides\n\nFabrication et installation sur mesure avec service après-vente\n\nSolutions pour bâtiments commerciaux, industriels et résidentiels\n\nDescription générale :\n\nOrca Lum est une entreprise marocaine spécialisée dans la conception, la fabrication et l’installation de portes et menuiseries en aluminium, ainsi que dans les solutions techniques isothermes pour les secteurs professionnels et industriels.\nNous fournissons des produits durables, esthétiques et performants, adaptés aux besoins des hôpitaux, hôtels, industries alimentaires et projets de construction variés.\n\nNotre objectif est d’offrir à nos clients des solutions fiables et sur mesure, alliant qualité, design, sécurité et performance thermique, tout en assurant un suivi technique complet avant et après installation.\n\nNos services :\n\nMenuiserie aluminium sur mesure : portes, fenêtres, façades, cloisons, volets, baies vitrées\n\nPortes isothermes pour hôpitaux, hôtels et industries agroalimentaires\n\nInstallation professionnelle avec respect des normes techniques et de sécurité\n\nAccompagnement client complet : étude de projet, fabrication, pose, maintenance et service après-vente\n\nSolutions pour tous types de bâtiment"",""image"":""https://lechantier.ma/uploads/media/4eaefc891bab.webp"",""logo"":""https://lechantier.ma/uploads/media/4eaefc891bab.webp"",""telephone"":""+212661115628"",""url"":""https://lechantier.ma/pros/profil/orca-lum"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""46, Bd Zerktouni étage 3, N° 6 c/o cadz, Casablanca"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Berrechid"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Berrechid"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Casablanca"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""El Jadida"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""El Jadida"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Fès"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Fès"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Kénitra"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Kénitra"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Mohammedia"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Mohammedia"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Rabat"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Rabat"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""003442538000075""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""itemListElement"":[{""@type"":""ListI