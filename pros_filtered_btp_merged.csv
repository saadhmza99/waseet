r.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/ingebatt-sarl"",""name"":""INGEBATT SARL "",""description"":""Basé à Casablanca, INGEBATT est un bureau d’études techniques spécialisé en ingénierie structurelle.\nDepuis plus de 30 ans, nous accompagnons promoteurs, architectes et entreprises dans la conception et l’optimisation de leurs projets de construction à travers tout le Maroc.\n\nNotre expertise couvre les études de structures béton armé, métalliques et mixtes, pour des projets résidentiels, tertiaires, industriels ou hôteliers. Nous intervenons sur l’ensemble des phases d’un projet : avant-projet, dimensionnement, plans d’exécution, notes de calculs, suivi technique et assistance au chantier.\n\nNotre équipe est composée d’ingénieurs expérimentés et de projeteurs qualifiés, engagés à produire des livrables fiables, précis et conformes aux normes en vigueur. Nous privilégions la rigueur, la réactivité et le respect des délais, tout en restant à l’écoute de nos partenaires.\n\nAvec plusieurs centaines de projets réalisés, INGEBATT s’est imposé comme un acteur reconnu du secteur. Nous mettons un point d’honneur à proposer des solutions techniques optimisées, parfaitement adaptées aux exigences de chaque projet."",""image"":""https://lechantier.ma/uploads/media/b003549c5684.webp"",""logo"":""https://lechantier.ma/uploads/media/b003549c5684.webp"",""telephone"":""+212666120685"",""url"":""https://lechantier.ma/pros/profil/ingebatt-sarl"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""104, Lotissement AL BADR"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Agadir"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Agadir"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Casablanca"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Fès"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Fès"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Marrakech"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Mohammedia"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Mohammedia"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Oujda"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Oujda"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Rabat"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Rabat"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Tanger"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Tanger"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Témara"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Témara"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Tétouan"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Tétouan"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""000084384000065""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""