//www.facebook.com/lechantier.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/vetco"",""name"":""VETCO"",""description"":""La société VETCO (Vente et Transformation de matériaux de Construction) est une entreprise marocaine basée à Biougra, dans la région d’Agadir, spécialisée dans la fabrication et la commercialisation de matériaux de construction. Grâce à une expertise solide et un engagement permanent envers la qualité, VETCO s’impose comme un partenaire de confiance pour les professionnels et les particuliers du secteur du bâtiment.\n\nNotre entreprise propose une gamme variée de produits, notamment :\n\nDes blocs en béton (agglos 10, 15, 20, 7),\n\nDes hourdis (16P, 15N, 12P),\n\nDu ciment,\n\nDes pointes (clous),\n\nDu fil de fer,\n\nDes PTS (poutrelles treillis soudées),\n\nDes poutrelles métalliques,\n\nEt du fer à béton.\n\nÉquipée de machines performantes et d’une équipe expérimentée, VETCO garantit des produits conformes aux normes marocaines en vigueur, tout en assurant des délais de livraison rapides et un service client réactif.\n\nNotre vision est centrée sur la qualité, la fiabilité, et la proximité avec nos clients. En intégrant continuellement les meilleures pratiques du secteur, VETCO contribue activement au développement de projets de construction durables dans la région du Souss-Massa.\n\n"",""image"":""https://lechantier.ma/uploads/media/60312adcc942.webp"",""logo"":""https://lechantier.ma/uploads/media/9489957e0801.webp"",""telephone"":""+212528810080"",""url"":""https://lechantier.ma/pros/profil/vetco"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""Douar TNE Siboumalek, Oued Essafa - Biougra"",""addressLocality"":""Agadir"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Agadir"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Agadir"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""001643061000012""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""itemListElement"":[{""@type"":""ListItem"",""position"":1,""name"":""Home"",""item"":""https://lechantier.ma/en""},{""@type"":""ListItem"",""position"":2,""name"":""Professionals"",""item"":""https://lechantier.ma/en/pros/annuaire""},{""@type"":""ListItem"",""position"":3,""name"":""Construction materials"",""item"":""https://lechantier.ma/en/metiers/materiaux""},{""@type"":""ListItem"",""position"":4,""name"":""VETCO"",""item"":""https://lechantier.ma/en/pros/profil/vetco""}]}],""headers"":{""alt-svc"":""h3=\"":443\""; ma=86400"",""cache-control"":""private, no-cache, no-store, max-age=0, must-revalidate"",""cf-cache-status"":""DYNAMIC"",""cf-ray"":""a4fd7471ee6ca8a4-ATL"",""content-encoding"":""zstd"",""content-security-policy"":""frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'; upgrade-insecure-requests"",""content-type"":""text/html; charset=utf-8"",""date"":""Sun, 25 Oct 2026 01:30:14 GMT"",""link"":""<https://lechantier.ma/pros/profil/vetco>; rel=\""alternate\""; hreflang=\""fr-MA\"", <https://lechantier.ma/ar/pros/profil/vetco>; rel=\""alternate\""; hreflang=\""ar-MA\"", <https://lechantier.ma/en/pros/pr