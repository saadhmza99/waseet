-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/ste-charbado-sarl"",""name"":""STE CHARBADO SARL"",""description"":""Charbado SARL - Bâtiment et Travaux Divers\n\nCharbado SARL est l’héritière d’un long parcours dans le domaine du bâtiment, initié en 1985 par l’entrepreneur expérimenté M. Mohamed Marzouq. Fort de plus de 78 projets réalisés en collaboration avec des administrations publiques à travers le Royaume, il a su bâtir une réputation fondée sur la qualité, le sérieux et la maîtrise technique.\n\nL’entreprise totalise un chiffre d’affaires cumulé de plus de 220 millions de dirhams, témoignant de son ancrage solide dans le secteur de la construction. Elle est également classée en 2ᵉ catégorie par le ministère de l’Équipement, qualification qui reflète son haut niveau de compétence et sa capacité à gérer des projets d’envergure.\n\nCharbado SARL se distingue par :\n\t•\tUne grande rigueur dans l’exécution des travaux\n\t•\tLe respect strict des délais et des cahiers de charges\n\t•\tUne équipe professionnelle et qualifiée\n\t•\tL’utilisation de matériaux de qualité supérieure\n\nAvec un héritage riche et une vision tournée vers l’avenir, Charbado SARL continue d’accompagner le développement du Royaume à travers des projets durables et structurants."",""image"":""https://lechantier.ma/uploads/media/9ba405e4466f.webp"",""logo"":""https://lechantier.ma/uploads/media/0d562fa0ad73.webp"",""telephone"":""+212700069069"",""url"":""https://lechantier.ma/pros/profil/ste-charbado-sarl"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""bd hassan 2 hay attakdom Azilal"",""addressLocality"":""Azilal"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Agadir"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Agadir"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Azilal"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Azilal"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Beni Mellal"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Beni Mellal"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Benslimane"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Benslimane"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Berrechid"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Berrechid"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Casablanca"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""El Jadida"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""El Jadida"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Fès"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Fès"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Kénitra"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Kénitra"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Marrakech"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Martil"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Martil"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Meknès"",""address"":{""@type"":""Post