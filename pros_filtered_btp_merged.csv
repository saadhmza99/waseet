try"":""MA""},""sameAs"":[""https://www.facebook.com/lechantier.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/s-i-t-e-f-ingenieur-geometre-topographe"",""name"":""S.I.T.E.F - Ingénieur Géomètre Topographe "",""description"":"" SITEF – Ingénieur Géomètre Topographe\nExpertise – Précision – Fiabilité\nBasée à Mohammedia, SITEF est un cabinet d’ingénierie topographique reconnu pour la qualité de ses prestations et de son engagement, Dirigé par un ingénieur Géomètre Topographe, Inscrit au Tableau de l'Ordre National des Ingénieurs Géomètres et Topographes ONIGT, le cabinet accompagne les particuliers, entreprises BTP et Génie civil, promoteurs immobiliers, administrations publiques dans tous leurs projets Fonciers, immobiliers et d'aménagement du territoire.\nNos domaines d'activité: Cadastre ( Dossiers Techniques ( Morcellement, Fusion, Lotissement, Mise en Concordance, Copropriété) \nTopographie: Levé Topographique, Rétablissement des bornes, Implantations des ouvrages, Plan de situation, Plan Parcellaire, Calcul des cubatures, Plan Côté Plan de Partage, Plan de projet de Morcellement.\nContrôle Topographique  externe des travaux  topographique ( Contrôle de la polygonale principale, les profils en travers , implantation des ouvrage , réception les couches de chaussées , contrôle des cubatures).\nSuivi la Réalisation des lotissement (Etudes Techniques, dossiers techniques, suivi des travaux).\nSITEF dispose des moyens humains de haut niveau et des moyens techniques  de précision ( Station Totale, des Récepteurs GNSS , Drone, SCAN 3D, Niveau de précision).\nNous garantissons un accompagnement personnalisé pour chaque projet , des prestations de qualité avec  un engament, et respect des délais. "",""image"":""https://lechantier.ma/uploads/media/e9dd734cbb77.webp"",""logo"":""https://lechantier.ma/uploads/media/a3cc75487172.webp"",""telephone"":""+212601932814"",""url"":""https://lechantier.ma/pros/profil/s-i-t-e-f-ingenieur-geometre-topographe"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""Boulevard Riad, Lotissement El Massira, N FB 09 4-ème étage appartement 10 "",""addressLocality"":""Mohammedia"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Azemmour"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Azemmour"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Benslimane"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Benslimane"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Berrechid"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Berrechid"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Casablanca"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""El Jadida"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""El Jadida"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Khémisset"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Khémisset"",""addressCountry"":""MA""}},{""@type"":""City"",""name"":""Marrakech"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""}},{""@type"":"