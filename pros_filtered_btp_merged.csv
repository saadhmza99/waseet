untry"":""MA""},""sameAs"":[""https://www.facebook.com/lechantier.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/archilines-architectes"",""name"":""ARCHILINES ARCHITECTES"",""description"":""Atelier d’Architecture ARCHILINES ARCHITECTES Marrakech \nSublimez vos espaces avec élégance et authenticité.\n\nÀ Marrakech, ville d’art, de lumière et de patrimoine, notre bureau d’architectes vous accompagne dans la réalisation de vos projets architecturaux sur mesure. Nous fusionnons tradition marocaine et design contemporain pour créer des espaces uniques, harmonieux et durables.\n\n✨ Ce que nous offrons:\n- Conception architecturale personnalisée: Villas de luxe, riads traditionnels, hôtels, commerces, espaces culturels.\n- Design intérieur & extérieur: Esthétique raffinée, optimisation des volumes, matériaux nobles et locaux.\n- Maîtrise des contraintes locales: Respect des normes urbanistiques, gestion des autorisations et intégration dans le tissu marocain.\n- Suivi complet des projets: De l’esquisse à la remise des clés, nous assurons un accompagnement professionnel et transparent.\n\n🌿 Pourquoi nous choisir?\n- Une approche artistique et fonctionnelle au cœur de chaque projet.\n- Une équipe passionnée ancrée dans la culture locale et ouverte aux inspirations internationales.\n- Une expérience client sur mesure, fondée sur l’écoute, le dialogue et la co-création.\n\nMarrakech est notre source d’inspiration… Votre projet est notre terrain d’expression."",""image"":""https://lechantier.ma/uploads/media/a5ad4269fa7e.webp"",""logo"":""https://lechantier.ma/uploads/media/fa1f75761524.webp"",""telephone"":""+212661331955"",""url"":""https://lechantier.ma/pros/profil/archilines-architectes"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""AV ALLAL EL FASSI COMPLEXE HABOUS 2 IMM B N°21"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Marrakech"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""002019514000023""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""itemListElement"":[{""@type"":""ListItem"",""position"":1,""name"":""Home"",""item"":""https://lechantier.ma/en""},{""@type"":""ListItem"",""position"":2,""name"":""Professionals"",""item"":""https://lechantier.ma/en/pros/annuaire""},{""@type"":""ListItem"",""position"":3,""name"":""Architect"",""item"":""https://lechantier.ma/en/pros/architecte""},{""@type"":""ListItem"",""position"":4,""name"":""ARCHILINES ARCHITECTES"",""item"":""https://lechantier.ma/en/pros/profil/archilines-architectes""}]}],""headers"":{""alt-svc"":""h3=\"":443\""; ma=86400"",""cache-control"":""private, no-cache, no-store, max-age=0, must-revalidate"",""cf-cache-status"":""DYNAMIC"",""cf-ray"":""a4fd6fa9bd3050ce-ARN"",""content-encoding"":""zstd"",""content-security-policy"":""frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'; upgrade-insecure-requests"",""content-type"":""text/html; charset=utf-8"",""date"":""Sun, 25 Oct 2026 01:26:58 GMT"",""link"":""<https://lechanti