cebook.com/lechantier.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/tretac"",""name"":""TRETAC"",""description"":""Chez TRETAC, nous mettons notre savoir-faire et notre expérience au service de vos projets de construction, d’aménagement et de rénovation.\nSpécialisés dans les travaux spéciaux du bâtiment, depuis plus de 27 ans, nous intervenons sur tous types de chantiers, pour les particuliers, les professionnels et les collectivités.\nNos domaines d’intervention :\n\t•\tDallage industriel et dallage décoratif : solutions résistantes et esthétiques, adaptées aux besoins des particuliers et des sites professionnels.\n\t•\tCuvelage : protection efficace contre les infiltrations et l’humidité.\n\t•\tÉtanchéité bitume et étanchéité liquide : pour toitures, terrasses, sous-sols ou piscines, assurant une protection totale et durable.\n\t•\tIsolation thermique et phonique : amélioration du confort et des performances énergétiques de vos bâtiments.\n\t•\tAménagements extérieurs : création d’espaces fonctionnels et harmonieux.\n\t•\tBéton décoratif : béton imprimé, taloché ou ciré pour des finitions esthétiques et modernes.\n\t•\tTravaux de façade : rénovation, ravalement et embellissement de vos bâtiments.\n\t•\tCons