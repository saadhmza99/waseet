:{""@type"":""PostalAddress"",""addressCountry"":""MA""},""sameAs"":[""https://www.facebook.com/lechantier.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/al-wajiha-btp"",""name"":""AL WAJIHA BTP "",""description"":""Al Wajiha est un bureau d’études en Bâtiment et Travaux Publics (BTP) situé à Casablanca, spécialisé dans la conception, l’ingénierie et l’accompagnement technique des projets de construction.\nNotre objectif est d’apporter à nos clients des solutions fiables, innovantes et conformes aux normes marocaines et internationales, tout en garantissant qualité, sécurité et respect des délais.\n\nNos domaines de compétences :\n\t•\tÉtudes techniques et structurelles : dimensionnement, stabilité des ouvrages, solutions de fondations et de structures adaptées.\n\t•\tConception architecturale et urbanistique : élaboration de plans, maquettes 3D, intégration esthétique et fonctionnelle des projets.\n\t•\tÉtudes fluides et techniques spéciales : électricité, plomberie, climatisation, ventilation, réseaux divers.\n\t•\tGestion et suivi de projets : coordination des intervenants, suivi de chantier, contrôle qualité et respect du calendrier.\n\t•\tConseil et assistance réglementaire : obtention des autorisations administratives, conformité aux normes et règlementations locales.\n\nNos engagements :\n\t•\tExcellence technique : des solutions étudiées et optimisées pour chaque projet.\n\t•\tInnovation : adoption des nouvelles méthodes de modélisation et du BIM pour une meilleure précision.\n\t•\tProximité client : écoute, réactivité et accompagnement personnalisé à chaque étape du projet.\n\t•\tDurabilité : intégration des principes de construction écoresponsable et d’efficacité énergétique.\n\n"",""image"":""https://lechantier.ma/uploads/media/d3e95ee19b42.webp"",""logo"":""https://lechantier.ma/uploads/media/d3e95ee19b42.webp"",""telephone"":""+212682146876"",""url"":""https://lechantier.ma/pros/profil/al-wajiha-btp"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""185 BD ABDERRAHIM BOUABID HAY TISSIR 2 etage 2 "",""addressLocality"":""Berrechid"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Berrechid"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Berrechid"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""003593834000044""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""itemListElement"":[{""@type"":""ListItem"",""position"":1,""name"":""Home"",""item"":""https://lechantier.ma/en""},{""@type"":""ListItem"",""position"":2,""name"":""Professionals"",""item"":""https://lechantier.ma/en/pros/annuaire""},{""@type"":""ListItem"",""position"":3,""name"":""Engineering firm"",""item"":""https://lechantier.ma/en/pros/bureau-etudes""},{""@type"":""ListItem"",""position"":4,""name"":""AL WAJIHA BTP "",""item"":""https://lechantier.ma/en/pros/profil/al-wajiha-btp""}]}],""headers"":{""alt-svc"":""h3=\"":443\""; ma=86400"",""cache-control"":""private, no-cache, no-store, max-age=0, must-revalidate"",""cf-cache-status"":""DYNAMIC"",""cf-ray"":""a4fd6ffb482d720e-PHX"",""content-encoding"":""zstd"",""content-security-policy"":""frame-anc