,""addressCountry"":""MA""},""sameAs"":[""https://www.facebook.com/lechantier.ma"",""https://www.instagram.com/lechantier.ma"",""https://www.linkedin.com/company/lechantier-ma""],""contactPoint"":{""@type"":""ContactPoint"",""contactType"":""customer service"",""availableLanguage"":[""French"",""Arabic"",""English""]}},{""@context"":""https://schema.org"",""@type"":""WebSite"",""name"":""lechantier.ma"",""url"":""https://lechantier.ma"",""description"":""Trouvez les meilleurs architectes, constructeurs et artisans au Maroc."",""inLanguage"":[""fr"",""ar"",""en""],""potentialAction"":{""@type"":""SearchAction"",""target"":{""@type"":""EntryPoint"",""urlTemplate"":""https://lechantier.ma/recherche?q={search_term_string}""},""query-input"":""required name=search_term_string""}},{""@context"":""https://schema.org"",""@type"":""LocalBusiness"",""@id"":""https://lechantier.ma/pros/profil/le-carre-d-elegance"",""name"":""Le Carré D'élégance"",""description"":""Le Carré d’Élégance est une société spécialisée dans la décoration intérieure et la conception architecturale 2D/3D, basée sur la créativité, la précision et le sens du détail.\nGrâce à notre atelier, nous offrons un accompagnement complet, depuis l’esquisse initiale jusqu’à la réalisation finale.\n\nNous proposons :\n\nConception 2D et 3D de plans architecturaux pour donner une vision claire et réaliste de vos projets.\n\nDécoration et aménagement intérieur sur mesure, adaptés à vos besoins et à votre style de vie.\n\nFabrication et personnalisation de mobilier et éléments décoratifs grâce à notre atelier.\n\nDes rendus réalistes et détaillés permettant d’anticiper le résultat final avant la mise en œuvre.\n\nNotre mission est de transformer vos idées en espaces uniques, en alliant esthétique, fonctionnalité et élégance. Que ce soit pour un projet résidentiel, professionnel ou commercial, nous créons des environnements raffinés et harmonieux qui reflètent votre personnalité et vos aspirations.\n\nAvec Le Carré d’Élégance, chaque projet devient une œuvre où design et confort s’unissent pour offrir une expérience de vie exceptionnelle."",""image"":""https://lechantier.ma/uploads/media/615384ca08be.webp"",""logo"":""https://lechantier.ma/uploads/media/e6e8f2db336c.webp"",""telephone"":""+212669393840"",""url"":""https://lechantier.ma/pros/profil/le-carre-d-elegance"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""MARRAKECH"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Marrakech"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Marrakech"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""111111111112222""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""itemListElement"":[{""@type"":""ListItem"",""position"":1,""name"":""Home"",""item"":""https://lechantier.ma/en""},{""@type"":""ListItem"",""position"":2,""name"":""Professionals"",""item"":""https://lechantier.ma/en/pros/annuaire""},{""@type"":""ListItem"",""position"":3,""name"":""Interior architect"",""item"":""https://lechantier.ma/en/metiers/architecte-interieur""},{""@type"":""ListItem"",""position"":4,""name"":""Le Carré D'élégance"",""item"":""https://lechantier.ma/en/pros/profil/le-carre-d-elegance""}]}],""headers"":{""alt-svc"":""h3=\"":443\""; ma=86400"",""cache-control"":""private, no-cache, no-store, max-age=0, must-revalidate"",""cf-cache-status"":""DYNAMIC"",""cf-ray"":""a4fd6f2abd3432b2-ARN"",""content-encoding"":""zstd"",""content-security-policy"":""frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'; upgrade-insecure-requests"",""content-type"":""text/html; charset=utf-8"",""date"":""Sun, 25 Oct 2026 01:26:38 GMT"",""link"":""<https://lechantier.ma/pros/profil/le-carre-d-elegance>; rel=\""alternate\""; hreflang=\""fr-MA\"", <https://lechantier.ma/ar/pros/profil/le-carre-d-elegance>; rel=