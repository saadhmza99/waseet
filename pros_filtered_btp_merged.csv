Elle met un point d’honneur à combiner rigueur technique, respect des délais et qualité de service, tout en intégrant des solutions innovantes et économes en énergie.\n\nEngagée envers la satisfaction de ses partenaires, SEREA se positionne aujourd’hui comme un acteur de confiance dans le secteur électrotechnique et énergétique au Maroc."",""image"":""https://lechantier.ma/uploads/media/c3ad50e1a0a0.webp"",""logo"":""https://lechantier.ma/uploads/media/3ba3e4c8d326.webp"",""telephone"":""+212641715519"",""url"":""https://lechantier.ma/pros/profil/serea"",""address"":{""@type"":""PostalAddress"",""streetAddress"":""Hay hassani "",""addressLocality"":""Casablanca"",""addressCountry"":""MA""},""areaServed"":[{""@type"":""City"",""name"":""Casablanca"",""address"":{""@type"":""PostalAddress"",""addressLocality"":""Casablanca"",""addressCountry"":""MA""}}],""priceRange"":""$$"",""identifier"":{""@type"":""PropertyValue"",""name"":""ICE"",""value"":""001751124000071""}},{""@context"":""https://schema.org"",""@type"":""BreadcrumbList"",""itemListElement"":[{""@type"":""ListItem"",""position"":1,""name"":""Home"",""item"":""https://lechantier.ma/en""},{""@type"":""ListItem"",""position"":2,""name"":""Professionals"",""item"":""https://lechantier.ma/en/pros/annuaire""},{""@type"":""ListItem"",""position"":3,""name"":""Électricien"",""item"":""https://lechantier.ma/en/metiers/electricien""},{""@type"":""ListItem"",""position"":4,""name"":""Serea"",""item"":""https://lechantier.ma/en/pros/profil/serea""}]}],""headers"":{""alt-svc"":""h3=\"":443\""; ma=86400"",""cache-control"":""private, no-cache, no-store, max-age=0, must-revalidate"",""cf-cache-status"":""DYNAMIC"",""cf-ray"":""a4fd74c9cdebfca7-LAX"",""content-encoding"":""zstd"",""content-security-policy"":""frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'; upgrade-insecure-requests"",""content-type"":""text/html; charset=utf-8"",""date"":""Sun, 25 Oct 2026 01:30:29 GMT"",""link""